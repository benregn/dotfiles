[user]
	name = Tomas Thor Jonsson
    useConfigOnly = true
	email =

[github]
    user = benregn

[core]
    excludesfile = ~/.gitignore_global
    editor = code --wait
    filemode = false
    trustctime = false
    logAllRefUpdates = true
    pager = delta

[commit]
	template = ~/.git-commit-msg
	cleanup = strip

[init]
    templatedir = ~/.git-templates
	defaultBranch = main

[interactive]
    diffFilter = delta --color-only --features=interactive

[delta]
    navigate = true
    line-numbers = true
    side-by-side = true
    features = "$(defaults read -globalDomain AppleInterfaceStyle &> /dev/null && echo dark-mode || echo light-mode)"

[delta "interactive"]
    keep-plus-minus-markers = false
    features = "$(defaults read -globalDomain AppleInterfaceStyle &> /dev/null && echo dark-mode || echo light-mode)"

[delta "light-mode"]
  light = true
  syntax-theme = Solarized (light)

[delta "dark-mode"]
  light = false
  syntax-theme = Solarized (dark)

[alias]
    a = add
    s = status -sb
    st = status
    stl = ls-files -m -o --exclude-standard
    ci = commit
    br = branch
    m = checkout master
    dev = checkout develop
    cr = clone --recursive

    co = checkout
    cob = checkout -b
    # cobi = !BRANCH=`jira mine --template git-branch | fzf` && git checkout develop && git pull && git checkout -b ${BRANCH}
    cobi = !BRANCH=`gh issue list | fzf` && git checkout master && git pull && git checkout -b ${BRANCH}
    coi = !BRANCH=`git recent-simple | fzf` && git checkout ${BRANCH}
    fza = "!git ls-files -m -o --exclude-standard | fzf --print0 -m | xargs -0 -t -o git add"

    fpush = push --force-with-lease

    d = diff
    ds = diff --staged
    dw = diff --word-diff
    dws = diff --word-diff --staged
    dfiles = diff --name-status master

    recent-simple = !git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads/
    undo = reset --soft HEAD^
    ag = !sh -c 'git ls-files -m -o --exclude-standard | grep $1 | xargs git add --verbose' -
    l = log --first-parent --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --max-count=5
    ll = log --first-parent --pretty=oneline --graph --abbrev-commit
    lm = log --first-parent --pretty=format:'* %s (%h)'
    lga = log --first-parent --all


    g = grep --break --heading --line-number
    amend = commit --amend --reuse-message=HEAD
    contrib = shortlog --summary --numbered

    email-guess = !. ~/.git-alias-email-guess.sh
    alias = !git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\ =\\ /
    change-commits = "!f() { VAR=$1; OLD=$2; NEW=$3; shift 3; git filter-branch --env-filter \"if [[ \\\"$`echo $VAR`\\\" = '$OLD' ]]; then export $VAR='$NEW'; fi\" $@; }; f"
    addm = "!git ls-files --deleted --modified --other --exclude-standard | fzf -0 -m --preview 'git diff --color=always {-1}' | xargs -r git add"
    addmp = "!git ls-files --deleted --modified --exclude-standard | fzf -0 -m --preview 'git diff --color=always {-1}' | xargs -r -o git add -p"
    # shift + "$@" because Git appends extra args to the *end* of shell aliases,
    # so `git fixup <sha> --flag` would land --flag after the rebase otherwise.
    fixup = "!f() { target=\"$1\"; shift; git commit --fixup \"$target\" && GIT_SEQUENCE_EDITOR=true git rebase -i --autosquash \"$@\" \"$target^\"; }; f"

[color]
    ui = auto
    diff = auto
    status = auto
    branch = auto
    interactive = auto
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "diff"]
    meta = yellow bold
    commit = green bold
    frag = magenta bold
    old = red bold
    new = green bold
    whitespace = red reverse
[color "diff-highlight"]
    oldNormal = red bold
    oldHighlight = "red bold 52"
    newNormal = "green bold"
    newHighlight = "green bold 22"
[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[credential]
    helper = osxkeychain

[grep]
    lineNumber = true

[help]
    autocorrect = 1

[difftool]
    prompt = false

[mergetool]
    prompt = false

[push]
    default = current

[fetch]
  prune = true

[diff]
    renames = copies
	tool = bc
[merge]
  tool = code
  conflictStyle = diff3
[mergetool "code"]
  cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED

[pull]
    rebase = true
[filter "media"]
    clean = git media clean %f
    smudge = git media smudge %f
    required = true
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    required = true
	process = git-lfs filter-process
[rebase]
    autosquash = true
    autostash = true
	updateRefs = true
[status]
    showUntrackedFiles = all
[stash]
    showPatch = true
[rerere]
	enabled = true

[gc]
    # default 90 days
    reflogExpire = 200
    # default 30 days
    reflogExpireUnreachable = 90
[blame]
	ignoreRevsFile = :(optional).git-blame-ignore-revs
[safe]
	directory = /Users/tomas/projects/beadsmith
	directory = /Users/tomas/projects/beadsmith
	directory = /Users/tomas/projects/beadsmith
	directory = /Users/tomas/projects/beadsmith
[trace2]
	eventTarget = af_unix:stream:/Users/tomas/.git-ai/internal/daemon/trace2.sock
	eventNesting = 0
