function extract () {
      if [ -f $1 ] ; then
        case $1 in
          *.tar.bz2)   tar xjf $1     ;;
          *.tar.gz)    tar xzf $1     ;;
          *.bz2)       bunzip2 $1     ;;
          *.rar)       unrar e $1     ;;
          *.gz)        gunzip $1      ;;
          *.tar)       tar xf $1      ;;
          *.tbz2)      tar xjf $1     ;;
          *.tgz)       tar xzf $1     ;;
          *.zip)       unzip $1       ;;
          *.Z)         uncompress $1  ;;
          *.7z)        7z x $1        ;;
          *)     echo "'$1' cannot be extracted via extract()" ;;
           esac
       else
           echo "'$1' is not a valid file"
       fi
     }

function fiex() {
    if [ -z "$1" ]; then
        if [ -z "$PROJECT_NAME" ]; then
            echo "Error: No argument provided and \$PROJECT_NAME is not set"
            exit 1
        else
            bin_app_name="$PROJECT_NAME"
        fi
    else
        bin_app_name="$1"
    fi

    app_name=${bin_app_name//_/-}

    echo "Connecting to $app_name"

    fly ssh console -a $app_name --pty -C "/app/bin/$bin_app_name remote"
}


# --- op completion (static + lazy notify) ---

OP_COMPLETION_DIR="$HOME/.zsh/completions"
OP_COMPLETION_FILE="$OP_COMPLETION_DIR/_op"
OP_VERSION_FILE="$OP_COMPLETION_DIR/.op_version"

opcomp-update() {
  command -v op >/dev/null 2>&1 || return 0
  mkdir -p "$OP_COMPLETION_DIR"
  op completion zsh > "$OP_COMPLETION_FILE" &&
    op --version | awk '{print $1}' > "$OP_VERSION_FILE"
}

opcomp-check() {
  command -v op >/dev/null 2>&1 || return 1
  local current saved
  current="$(op --version 2>/dev/null | awk '{print $1}')"
  saved="$(cat "$OP_VERSION_FILE" 2>/dev/null)"
  [[ "$current" != "$saved" ]]
}

# fzf-powered worktree cleanup — TAB to multi-select, ENTER to wt remove
# claude --resume "wt-clean-fzf-function"
function wt-clean() {
  local selected tmpjson tmpdir branch safe
  tmpjson=$(mktemp /tmp/wt-list.XXXXXX)
  tmpdir=$(mktemp -d /tmp/wt-pr.XXXXXX)

  # Fetch worktree list once
  wt list --format=json > "$tmpjson"

  # Kick off parallel PR lookups for all non-main branches
  while IFS= read -r branch; do
    safe="${branch//\//_}"
    gh pr list --state merged --head "$branch" \
      --json number --jq 'if length > 0 then "#\(.[0].number)" else "-" end' \
      > "$tmpdir/$safe" 2>/dev/null &
  done < <(jq -r '.[] | select(.is_main == false) | .branch' "$tmpjson")
  wait

  # Merge PR status into the JSON — all data local from here on
  jq -r '.[] | select(.is_main == false) | @json' "$tmpjson" \
  | while IFS= read -r entry; do
      branch=$(jq -r '.branch' <<< "$entry")
      safe="${branch//\//_}"
      pr=$(cat "$tmpdir/$safe" 2>/dev/null || echo "-")
      jq --arg pr "$pr" '. + {pr: $pr}' <<< "$entry"
    done \
  | jq -s '.' > "$tmpjson.e" && mv "$tmpjson.e" "$tmpjson"
  rm -rf "$tmpdir"

  selected=$(
    jq -r '
      .[]
      | (if ((.working_tree.modified? // false) or (.working_tree.staged? // false) or (.working_tree.untracked? // false)) then "!" else " " end) as $dirty
      | [
          .branch,
          (.branch + "  " + $dirty + " " + .pr + "  " + (.commit.short_sha // "?") + "  " + (.commit.message | .[0:55]))
        ]
      | @tsv
    ' "$tmpjson" \
    | fzf --multi \
          --ansi \
          --header='TAB: select  ENTER: wt remove  ESC: cancel' \
          --header-first \
          --delimiter=$'\t' \
          --with-nth=2 \
          --preview="jq -r --arg b {1} '.[] | select(.branch == \$b) | \"Branch: \(.branch)\nPath:   \(.path)\nCommit: \(.commit.short_sha // \"?\") \(.commit.message)\nPR:     \(.pr)\"' $tmpjson" \
          --preview-window='bottom:6:wrap'
  ) || { rm -f "$tmpjson"; return 0; }

  rm -f "$tmpjson"
  [[ -z "$selected" ]] && return 0

  local -a branches
  branches=(${(f)"$(echo "$selected" | cut -f1)"})

  print -l "Removing worktrees:" "${branches[@]}"
  wt remove "${branches[@]}"
}
